      "description": "",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "editorMode": "code",
          "expr": "count(count by(http_route) (http_server_request_duration_seconds_count{service_name=~\"$service\", http_route=~\"$route\"}))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "refId": "A"
