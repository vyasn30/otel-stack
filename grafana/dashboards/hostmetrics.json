{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "title": "OTel Host Metrics",
  "uid": "otel-hostmetrics",
  "tags": [
    "otel",
    "hostmetrics"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "disk",
        "label": "Disk",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "query": {
          "query": "label_values(system_disk_io_bytes_total{device!~\"loop.*\"}, device)",
          "refId": "disk"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "netdev",
        "label": "Interface",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "query": {
          "query": "label_values(system_network_io_bytes_total{device!~\"lo|veth.*|br-.*|docker.*\"}, device)",
          "refId": "netdev"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "mount",
        "label": "Mountpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "query": {
          "query": "label_values(system_filesystem_usage_bytes{type!=\"squashfs\"}, mountpoint)",
          "refId": "mount"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "gauge",
      "title": "CPU",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "editorMode": "code",
          "expr": "100 * (1 - rate(system_cpu_time_seconds_total{state=\"idle\"}[$__rate_interval]) / scalar(system_cpu_logical_count))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true
      }
    },
